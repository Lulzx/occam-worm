# Data: raw downloads are immutable and never committed; normalized tables and splits are local.
/data/raw/*
/data/normalized/*
/data/splits/*
/data/derived/*
!/data/**/README.md

# Generated run outputs (content-addressed; published separately)
/artifacts/*
!/artifacts/README.md

