{
  "name": "tanh-sigmoid",
  "description": "tanh and sigmoid of the stimulus; their sum is read one tick later.",
  "derivation": "dt = tau = 1 so y(t+1) = tanh(u(t)), w(t+1) = 1/(1 + exp(-u(t))) and out(t+1) = y(t) + w(t); tolerance 1e-12 covers libm differences. Includes u = 0 (tanh 0 = 0, sigmoid 0 = 0.5) and a sign change.",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G1",
      "dt_max 1",
      "param tau : s = 1 fixed",
      "input u = stimulus",
      "state y : 1 = 0",
      "state w : 1 = 0",
      "state out : 1 = 0",
      "next y = euler_leak(y, tanh(u), tau)",
      "next w = euler_leak(w, sigmoid(u), tau)",
      "next out = euler_leak(out, y + w, tau)",
      "observe identity_v1(out)"
    ]
  },
  "input": {
    "dt": 1.0,
    "n_steps": 6,
    "graph": {
      "neurons": [
        {"id": "T0"},
