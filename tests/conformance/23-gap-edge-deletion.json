{
  "name": "gap-edge-deletion",
  "description": "edits.delete_gap removes the B-C junction, leaving C isolated at its initial value.",
  "derivation": "Only the A-B junction (g = 3) remains: the dyadic recurrence (v_i + 3 v_j)/4 on (A, B) from (1, 0); the isolated C keeps 0.5 (G = S = 0 leaves w unchanged).",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G1",
      "state v : 1 = 0",
      "gap v",
      "observe identity_v1(v)"
    ]
  },
  "input": {
    "dt": 1.0,
    "n_steps": 5,
    "graph": {
      "neurons": [
        {"id": "A"},
        {"id": "B"},
        {"id": "C"}
      ],
      "chemical": [],
      "gap": [
        {"a": "A", "b": "B", "g": 3.0},
        {"a": "B", "b": "C", "g": 1.0}
      ]
    },
    "stimulus": [],
    "initial_state": {
      "v": {"A": 1.0, "C": 0.5}
    },
    "edits": {
      "delete_gap": [
        [
          "B",
          "C"
        ]
      ]
    }
  },
  "check": {
    "type": "traces",
    "tolerance": {"abs": 0, "rel": 0},
    "expected": {
      "registers": {
        "v": [
          [1.0, 0.0, 0.5],
          [0.25, 0.75, 0.5],
          [0.625, 0.375, 0.5],
          [0.4375, 0.5625, 0.5],
          [0.53125, 0.46875, 0.5],
          [0.484375, 0.515625, 0.5]
        ]
      }
    }
  }
}
