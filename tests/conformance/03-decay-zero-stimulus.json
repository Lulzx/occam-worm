{
  "name": "decay-zero-stimulus",
  "description": "decay(v, tau) from an initial value of 0.5 with no stimulus.",
  "derivation": "decay is leaky_integrate towards 0, the exact solution of dx/dt = -x/tau: v_n = 0.5 exp(-n dt / tau).",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G1",
      "state v : 1 = 0.5",
      "param tau : s = 0.5 fixed",
      "next v = decay(v, tau)",
      "observe identity_v1(v)"
    ]
  },
  "input": {
    "dt": 0.1,
    "n_steps": 20,
    "graph": {
      "neurons": [
        {"id": "A"}
      ],
      "chemical": [],
      "gap": []
    },
    "stimulus": []
  },
  "check": {
    "type": "traces",
    "tolerance": {"abs": 1e-12, "rel": 0},
    "expected": {
      "registers": {
        "v": [
          [0.5],
          [0.4093653765389909],
          [0.33516002301781966],
          [0.2744058180470132],
