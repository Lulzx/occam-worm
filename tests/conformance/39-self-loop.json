{
  "name": "self-loop",
  "description": "Chemical self-edges with delay 0 and delay 2.",
  "derivation": "A(t+1) = u(t) + 0.5 A(t): an impulse decays as 1, .5, .25, ... B(t+1) = u(t) + B(t-2): the impulse recirculates with period 3 (1 at ticks 1, 4, 7, 10).",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G1",
      "dt_max 1",
      "state v : 1 = 0",
      "param tau : s = 1 fixed",
      "input u = stimulus",
      "input e = sum_in(v, exc)",
      "next v = euler_leak(v, u + e, tau)",
      "observe identity_v1(v)"
    ]
  },
  "input": {
    "dt": 1.0,
    "n_steps": 10,
    "graph": {
      "neurons": [
        {"id": "A"},
        {"id": "B"}
      ],
      "chemical": [
        {"pre": "A", "post": "A", "weight": 0.5, "sign": 1, "delay": 0},
        {"pre": "B", "post": "B", "weight": 1.0, "sign": 1, "delay": 2}
      ],
      "gap": []
    },
    "stimulus": [
      {"neuron": "A", "start": 0, "end": 1, "amplitude": 1.0},
      {"neuron": "B", "start": 0, "end": 1, "amplitude": 1.0}
    ]
  },
  "check": {
    "type": "traces",
    "tolerance": {"abs": 0, "rel": 0},
    "expected": {
      "registers": {
        "v": [
          [0.0, 0.0],
          [1.0, 1.0],
          [0.5, 0.0],
          [0.25, 0.0],
          [0.125, 1.0],
          [0.0625, 0.0],
          [0.03125, 0.0],
          [0.015625, 1.0],
          [0.0078125, 0.0],
          [0.00390625, 0.0],
          [0.001953125, 1.0]
        ]
      }
    }
  }
}
