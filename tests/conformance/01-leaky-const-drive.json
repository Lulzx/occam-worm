{
  "name": "leaky-const-drive",
  "description": "One neuron, leaky_integrate towards a constant stimulus of 1.",
  "derivation": "Each step is the exact exponential step with the target held at 1, so v_n = 1 - exp(-n dt / tau) with dt = 0.1, tau = 0.4. The identity observation equals the register.",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G1",
      "state v : 1 = 0",
      "param tau : s = 0.4 fixed",
      "next v = leaky_integrate(v, stimulus, tau)",
      "observe identity_v1(v)"
    ]
  },
  "input": {
    "dt": 0.1,
    "n_steps": 20,
    "graph": {
      "neurons": [
        {"id": "A"}
      ],
      "chemical": [],
      "gap": []
    },
    "stimulus": [
      {"neuron": "A", "start": 0, "end": 20, "amplitude": 1.0}
    ]
  },
  "check": {
    "type": "traces",
    "tolerance": {"abs": 1e-12, "rel": 0},
