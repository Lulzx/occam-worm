{
  "name": "g0-rule90",
  "description": "Ring of 8 cells with in-edges from both ring neighbours; one live cell; elementary rule 90.",
  "derivation": "count_in(s, 1) is the number of live neighbours; lut [0, 1, 0] maps it to the XOR of the two neighbours: new[i] = old[i-1] xor old[i+1], iterated 6 generations by hand from a single live cell.",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G0",
      "state s : 1 = 0",
      "next s = lut(count_in(s, 1), [0, 1, 0])",
      "observe identity_v1(s)"
    ]
  },
  "input": {
    "dt": 1.0,
    "n_steps": 6,
    "graph": {
