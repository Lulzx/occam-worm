        {"pre": "N1", "post": "N0", "weight": 1.0, "sign": 1, "delay": 0},
        {"pre": "N1", "post": "N2", "weight": 1.0, "sign": 1, "delay": 0},
        {"pre": "N2", "post": "N1", "weight": 1.0, "sign": 1, "delay": 0},
