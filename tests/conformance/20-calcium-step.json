{
  "name": "calcium-step",
  "description": "Calcium filter of a step input and of non-zero initial registers (c(0) = x(0)).",
  "derivation": "c(0) = x(0). With x(k) = X for k >= 1: c(k) = X + (x(0) - X) a^k, a = exp(-dt/tau), dt = 0.25, tau = 0.5: A (0 -> 1): 1 - a^k; B (0.6 -> 0): 0.6 a^k; C (0.6 -> 1): 1 - 0.4 a^k.",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G1",
      "state x : 1 = 0",
      "next x = stimulus",
      "observe calcium_linear_v1(x, 0.5[s])"
    ]
  },
  "input": {
    "dt": 0.25,
    "n_steps": 8,
    "graph": {
      "neurons": [
        {"id": "A"},
        {"id": "B"},
        {"id": "C"}
      ],
      "chemical": [],
      "gap": []
    },
    "stimulus": [
      {"neuron": "A", "start": 0, "end": 8, "amplitude": 1.0},
      {"neuron": "C", "start": 0, "end": 8, "amplitude": 1.0}
    ],
    "initial_state": {
      "x": {"B": 0.6, "C": 0.6}
    }
  },
  "check": {
    "type": "traces",
    "tolerance": {"abs": 1e-12, "rel": 0},
    "expected": {
      "registers": {
        "x": [
          [0.0, 0.6, 0.6],
          [1.0, 0.0, 1.0],
          [1.0, 0.0, 1.0],
          [1.0, 0.0, 1.0],
          [1.0, 0.0, 1.0],
          [1.0, 0.0, 1.0],
          [1.0, 0.0, 1.0],
          [1.0, 0.0, 1.0],
          [1.0, 0.0, 1.0]
        ]
      },
      "observation": [
        [0.0, 0.6, 0.6],
        [0.3934693402873666, 0.36391839582758007, 0.7573877361149466],
        [0.6321205588285577, 0.2207276647028654, 0.8528482235314231],
        [0.7768698398515702, 0.13387809608905787, 0.9107479359406281],
        [0.8646647167633873, 0.08120116994196762, 0.9458658867053549],
        [0.9179150013761012, 0.049250999174339276, 0.9671660005504404],
        [0.950212931632136, 0.029872241020718365, 0.9800851726528544],
        [0.9698026165776815, 0.0181184300533911, 0.9879210466310726],
        [0.9816843611112658, 0.010989383333240508, 0.9926737444445063]
      ]
    }
  }
}
