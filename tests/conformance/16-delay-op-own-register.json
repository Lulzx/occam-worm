{
  "name": "delay-op-own-register",
  "description": "delay(v, 2) reads the neuron's own register two ticks back; initial value 0.5.",
  "derivation": "dt = tau = 1 so v(t+1) = u(t) + v(t-2) with v(s<0) = v(0) = 0.5. B (no stimulus) stays 0.5; A gets pulses at ticks 0 and 2 that recirculate with period 3.",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G1",
      "dt_max 1",
      "state v : 1 = 0.5",
      "param tau : s = 1 fixed",
      "next v = euler_leak(v, stimulus + delay(v, 2), tau)",
      "observe identity_v1(v)"
    ]
  },
  "input": {
    "dt": 1.0,
    "n_steps": 12,
    "graph": {
      "neurons": [
        {"id": "A"},
        {"id": "B"}
      ],
      "chemical": [],
      "gap": []
    },
    "stimulus": [
      {"neuron": "A", "start": 0, "end": 1, "amplitude": 1.0},
      {"neuron": "A", "start": 2, "end": 3, "amplitude": 1.0}
    ]
  },
  "check": {
    "type": "traces",
    "tolerance": {"abs": 0, "rel": 0},
    "expected": {
      "registers": {
        "v": [
          [0.5, 0.5],
          [1.5, 0.5],
          [0.5, 0.5],
          [1.5, 0.5],
          [1.5, 0.5],
          [0.5, 0.5],
          [1.5, 0.5],
          [1.5, 0.5],
          [0.5, 0.5],
          [1.5, 0.5],
          [1.5, 0.5],
          [0.5, 0.5],
          [1.5, 0.5]
        ]
      }
    }
  }
}
