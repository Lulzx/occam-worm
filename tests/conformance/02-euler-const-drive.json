{
  "name": "euler-const-drive",
  "description": "One neuron, euler_leak towards a constant stimulus of 1 (rate dt/tau = 0.25).",
  "derivation": "x + 0.25 (1 - x) has fixed point 1 and error multiplier 0.75, so v_n = 1 - 0.75^n.",
  "program": {
    "source": [
      "wrl 0.1",
      "tier G1",
      "dt_max 0.1",
      "state v : 1 = 0",
      "param tau : s = 0.4 fixed",
      "next v = euler_leak(v, stimulus, tau)",
      "observe identity_v1(v)"
    ]
  },
  "input": {
    "dt": 0.1,
    "n_steps": 20,
    "graph": {
      "neurons": [
        {"id": "A"}
      ],
      "chemical": [],
      "gap": []
    },
    "stimulus": [
      {"neuron": "A", "start": 0, "end": 20, "amplitude": 1.0}
    ]
  },
  "check": {
    "type": "traces",
    "tolerance": {"abs": 1e-12, "rel": 0},
    "expected": {
      "registers": {
        "v": [
          [0.0],
          [0.25],
          [0.4375],
          [0.578125],
          [0.68359375],
          [0.7626953125],
          [0.822021484375],
          [0.86651611328125],
          [0.8998870849609375],
          [0.9249153137207031],
          [0.9436864852905273],
          [0.9577648639678955],
          [0.9683236479759216],
          [0.9762427359819412],
          [0.9821820519864559],
          [0.9866365389898419],
          [0.9899774042423815],
          [0.9924830531817861],
          [0.9943622898863396],
          [0.9957717174147547],
          [0.996828788061066]
        ]
      }
    }
  }
}
